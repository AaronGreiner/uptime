{
  "name": "uptime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun nuxt build",
    "dev": "bun --bun nuxt dev",
    "preview": "bun --bun nuxt preview",
    "start": "bun .output/server/index.mjs",
    "postinstall": "bun --bun nuxt prepare",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "typecheck": "bun --bun nuxt typecheck",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "grid-layout-plus": "^1.1.1",
    "lucide": "^1.33.0",
    "morphicons": "^1.7.0",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "tailwindcss": "^4.3.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/bun": "1.3.9",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.10"
  },
  "packageManager": "bun@1.3.9",
  "description": "A minimal, self-hosted uptime monitor with editable dashboards.",
  "license": "MIT"
}
