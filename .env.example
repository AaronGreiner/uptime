# --- Required ---------------------------------------------------------------

# Secret used to seal the admin session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars

# Marks the session cookie as Secure, which a browser then only sends over
# HTTPS — and silently drops on a plain http:// origin, so an instance reached
# over HTTP could never sign in. Defaults to true; in Docker an unset value is
# derived from NUXT_PUBLIC_APP_URL instead. Left commented out on purpose, so
# copying this file does not pin the answer before the origin is known.
# NUXT_SESSION_COOKIE_SECURE=true

# --- Admin account ----------------------------------------------------------
# Seeded on the first start only. Change credentials later in the UI under
# Settings. When the password is left empty a random one is generated and
# printed to the log exactly once.
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=

# Set to false on a shared demo to keep visitors from changing the username or
# password. The account update endpoint enforces this on the server.
NUXT_PUBLIC_ACCOUNT_UPDATES_ENABLED=true

# --- Storage ----------------------------------------------------------------

# SQLite database file. Point this at a mounted volume when using Docker.
NUXT_DATABASE_PATH=./data/uptime.db

# Folder containing the generated drizzle migrations.
NUXT_MIGRATIONS_DIR=./drizzle

# --- Scheduler --------------------------------------------------------------

# Set to false to run the UI without executing any checks.
NUXT_SCHEDULER_ENABLED=true

# Maximum number of checks running at the same time.
NUXT_SCHEDULER_CONCURRENCY=10

# How often the scheduler looks for due monitors, in milliseconds.
NUXT_SCHEDULER_TICK_INTERVAL_MS=1000

# --- Retention --------------------------------------------------------------

# Days of raw per-check results to keep. Hourly aggregates are written before
# raw rows are pruned, so long range charts survive.
NUXT_RETENTION_HEARTBEAT_DAYS=7

# Days of hourly aggregates to keep.
NUXT_RETENTION_HOURLY_STATS_DAYS=365

# Days of notification delivery history to keep. The newest entry per monitor
# and channel is always kept, because it is what tells a later recovery whether
# the outage was ever announced.
NUXT_RETENTION_NOTIFICATION_DAYS=30

# --- Notifications ----------------------------------------------------------

# Set to false to queue notifications without ever delivering them.
NUXT_NOTIFICATIONS_ENABLED=true

# Hard deadline for one delivery attempt, in milliseconds. Each provider
# enforces this for itself; the queue watchdog sits above it with a grace period.
NUXT_NOTIFICATIONS_SEND_TIMEOUT_MS=15000

# Attempts per delivery before it is given up on. The waits in between are
# 30 s, 2 min and 10 min.
NUXT_NOTIFICATIONS_MAX_ATTEMPTS=4

# How many deliveries the worker handles per tick, so one slow transport does
# not hold up the others.
NUXT_NOTIFICATIONS_CONCURRENCY=5

# How often the worker looks for due deliveries, in milliseconds.
NUXT_NOTIFICATIONS_TICK_INTERVAL_MS=2000

# --- Demo data --------------------------------------------------------------

# Creates demo monitors, a demo dashboard and synthetic history on an empty
# database. The demo monitors point at real public endpoints, so enabling this
# makes the scheduler send actual requests to them. Runs at most once.
NUXT_SEED_DEMO_DATA=false

# Days of generated history for the demo monitors.
NUXT_SEED_DEMO_HISTORY_DAYS=7

# --- Branding ---------------------------------------------------------------

NUXT_PUBLIC_APP_NAME=Uptime

# Public base URL of this instance, without a trailing slash. Notifications link
# back to the monitor they are about; while this is empty they leave the link out
# rather than pointing at localhost.
NUXT_PUBLIC_APP_URL=
